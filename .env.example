# OPTIONAL - Upstash Redis free tier, keeps stats alive across cold starts
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OPTIONAL - comma separated links for /api/cron
TARGET_LINKS=

# Set on Vercel to skip a useless 300MB browser download during build
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# OPTIONAL - auth. When set, the dashboard asks for the token once and stores it
# in localStorage; /api/visit and /api/resolve then require it.
ACCESS_TOKEN=

# OPTIONAL - protects /api/cron. Vercel Cron sends it as a Bearer token.
CRON_SECRET=

# OPTIONAL - how long a single dashboard visit may run (ms, default 150000).
# Must stay below maxDuration in vercel.json.
VISIT_DEADLINE_MS=
